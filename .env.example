# ============================================================
# FinSight — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ============================================================

# Django Core
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-50
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (used by Docker Compose)
DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://finsight:${DB_PASSWORD}@db:5432/finsight

# Redis (used by Docker Compose)
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Fernet encryption key for bank tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-generate-fernet-key

# TrueLayer Open Banking
# Register free sandbox at: https://console.truelayer.com
TRUELAYER_CLIENT_ID=sandbox-your-client-id
TRUELAYER_CLIENT_SECRET=your-client-secret
TRUELAYER_REDIRECT_URI=http://localhost:8000/api/v1/banking/callback/
TRUELAYER_ENV=sandbox

# Anthropic (Claude Sonnet AI briefings)
# Get at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# FX Rates — ExchangeRate-API (free: 1,500 req/month)
# Register at: https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=your-key-here

# Historical FX — Alpha Vantage (free: 25 req/day)
# Register at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your-key-here

# Email (Django sends verification + digest emails)
# Option 1: Gmail App Password (Settings > Security > App passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=FinSight <your@gmail.com>

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
